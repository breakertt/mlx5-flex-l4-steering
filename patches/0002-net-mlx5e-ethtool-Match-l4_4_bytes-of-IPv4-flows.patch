From 50413dc17b4e24b1ef53e2ce43508f7034b9db34 Mon Sep 17 00:00:00 2001
From: Tianyi Gao <tianyi.gao@ed.ac.uk>
Date: Fri, 9 Oct 2026 22:06:19 +0000
Subject: [PATCH 2/3] net/mlx5e: ethtool, Match l4_4_bytes of IPv4 flows

For an IP protocol other than TCP and UDP, RSS can only hash the IP
addresses, so all of its traffic between two hosts lands on one RX queue.
ethtool can steer by the protocol's own header:

  ethtool -N <dev> flow-type ip4 l4proto <N> l4data <v> m <m> action <q>

but mlx5e rejects every IP_USER_FLOW rule that sets l4_4_bytes.

Support it on devices with a programmable flex parser. The first such
rule creates a parse graph node that is entered from the IP node when the
protocol is N, has a fixed 4-byte header and samples its dword 0. Rules
match the sample in misc_parameters_4, next to the existing address and
protocol match. The node is reference counted by the rules and destroyed
with the last one. There is one node, so all l4_4_bytes rules must name
the same protocol; a rule for another one fails with -EBUSY. Without the
capability the rule fails with -EOPNOTSUPP.

l4_4_bytes stays rejected for protocols the fixed parser handles, as a
node on one of them takes over its parsing: with a node on GRE, GRE
traffic that was spread over 24 queues by its inner headers collapsed
onto one. The IP node compares the IPv6 next header as well, so ICMPv6
and the IPv6 extension headers are refused too.

A flex parser sample cannot be an RSS hash input, so spreading a protocol
over queues takes one rule per bucket, e.g. 16 rules on the low nibble
of a port field.

The node is tracked per netdev, which assumes one netdev per function.

Signed-off-by: Tianyi Gao <tianyi.gao@ed.ac.uk>
---
 .../mellanox/mlx5/core/en_fs_ethtool.c        | 207 +++++++++++++++++-
 1 file changed, 204 insertions(+), 3 deletions(-)

diff --git a/drivers/net/ethernet/mellanox/mlx5/core/en_fs_ethtool.c b/drivers/net/ethernet/mellanox/mlx5/core/en_fs_ethtool.c
index 79916f1ab..48289cdb6 100644
--- a/drivers/net/ethernet/mellanox/mlx5/core/en_fs_ethtool.c
+++ b/drivers/net/ethernet/mellanox/mlx5/core/en_fs_ethtool.c
@@ -44,11 +44,20 @@ struct mlx5e_ethtool_table {
 #define ETHTOOL_NUM_L3_L4_FTS 7
 #define ETHTOOL_NUM_L2_FTS 4
 
+/* Flex parse graph node matching l4_4_bytes, shared by all rules that use it */
+struct mlx5e_ethtool_flex_l4 {
+	u32 obj_id;
+	u32 sample_id;
+	int refcount;
+	u8 proto;
+};
+
 struct mlx5e_ethtool_steering {
 	struct mlx5e_ethtool_table      l3_l4_ft[ETHTOOL_NUM_L3_L4_FTS];
 	struct mlx5e_ethtool_table      l2_ft[ETHTOOL_NUM_L2_FTS];
 	struct list_head                rules;
 	int                             tot_num_rules;
+	struct mlx5e_ethtool_flex_l4    flex_l4;
 };
 
 static int flow_type_to_traffic_type(u32 flow_type);
@@ -64,6 +73,7 @@ struct mlx5e_ethtool_rule {
 	struct mlx5_flow_handle	     *rule;
 	struct mlx5e_ethtool_table   *eth_ft;
 	struct mlx5e_rss             *rss;
+	bool                         flex_l4;
 };
 
 static void put_flow_table(struct mlx5e_ethtool_table *eth_ft)
@@ -453,6 +463,187 @@ static int flow_get_tirn(struct mlx5e_priv *priv,
 	return 0;
 }
 
+/* l4_4_bytes of an IP protocol that the fixed parser does not know is matched
+ * through a flex parse graph node. The node is entered from the IP node on the
+ * IPv4 protocol or IPv6 next header, and samples the first dword after the IP
+ * header. There is one node, so all l4_4_bytes rules must use one protocol.
+ */
+static bool flex_l4_supported(u8 proto_mask, u8 proto)
+{
+	if (proto_mask != 0xff)
+		return false;
+
+	/* A node on a protocol that the fixed parser handles takes over its
+	 * parsing: GRE traffic, for one, loses its inner RSS. The arc is shared
+	 * by IPv4 and IPv6, so IPv6 extension headers are excluded as well.
+	 */
+	switch (proto) {
+	case IPPROTO_HOPOPTS:
+	case IPPROTO_ICMP:
+	case IPPROTO_IPIP:
+	case IPPROTO_TCP:
+	case IPPROTO_UDP:
+	case IPPROTO_IPV6:
+	case IPPROTO_ROUTING:
+	case IPPROTO_FRAGMENT:
+	case IPPROTO_GRE:
+	case IPPROTO_ESP:
+	case IPPROTO_ICMPV6:
+	case IPPROTO_NONE:
+	case IPPROTO_DSTOPTS:
+		return false;
+	default:
+		return true;
+	}
+}
+
+static int flex_l4_create(struct mlx5_core_dev *mdev, u8 proto, u32 *obj_id)
+{
+	u32 out[MLX5_ST_SZ_DW(general_obj_out_cmd_hdr)] = {};
+	u32 in[MLX5_ST_SZ_DW(create_flex_parser_in)] = {};
+	void *hdr, *flex, *sample, *arc;
+	int err;
+
+	hdr = MLX5_ADDR_OF(create_flex_parser_in, in, hdr);
+	flex = MLX5_ADDR_OF(create_flex_parser_in, in, flex);
+	sample = MLX5_ADDR_OF(parse_graph_flex, flex, sample_table[0]);
+	arc = MLX5_ADDR_OF(parse_graph_flex, flex, input_arc[0]);
+
+	MLX5_SET(general_obj_in_cmd_hdr, hdr, opcode, MLX5_CMD_OP_CREATE_GENERAL_OBJECT);
+	MLX5_SET(general_obj_in_cmd_hdr, hdr, obj_type, MLX5_OBJ_TYPE_FLEX_PARSE_GRAPH);
+
+	/* A 4-byte header, sampled as dword 0 at a fixed offset */
+	MLX5_SET(parse_graph_flex, flex, header_length_mode, MLX5_GRAPH_NODE_LEN_FIXED);
+	MLX5_SET(parse_graph_flex, flex, header_length_base_value, 4);
+	MLX5_SET(parse_graph_flow_match_sample, sample, flow_match_sample_en, 1);
+	MLX5_SET(parse_graph_flow_match_sample, sample, flow_match_sample_tunnel_mode,
+		 MLX5_GRAPH_SAMPLE_TUNNEL_FIRST);
+
+	MLX5_SET(parse_graph_arc, arc, arc_parse_graph_node, MLX5_GRAPH_ARC_NODE_IP);
+	MLX5_SET(parse_graph_arc, arc, compare_condition_value, proto);
+
+	err = mlx5_cmd_exec(mdev, in, sizeof(in), out, sizeof(out));
+	if (err)
+		return err;
+
+	*obj_id = MLX5_GET(general_obj_out_cmd_hdr, out, obj_id);
+	return 0;
+}
+
+static int flex_l4_query_sample_id(struct mlx5_core_dev *mdev, u32 obj_id, u32 *sample_id)
+{
+	u32 in[MLX5_ST_SZ_DW(general_obj_in_cmd_hdr)] = {};
+	u32 out[MLX5_ST_SZ_DW(query_flex_parser_out)] = {};
+	void *sample;
+	int err;
+
+	MLX5_SET(general_obj_in_cmd_hdr, in, opcode, MLX5_CMD_OP_QUERY_GENERAL_OBJECT);
+	MLX5_SET(general_obj_in_cmd_hdr, in, obj_type, MLX5_OBJ_TYPE_FLEX_PARSE_GRAPH);
+	MLX5_SET(general_obj_in_cmd_hdr, in, obj_id, obj_id);
+
+	err = mlx5_cmd_exec(mdev, in, sizeof(in), out, sizeof(out));
+	if (err)
+		return err;
+
+	sample = MLX5_ADDR_OF(query_flex_parser_out, out, flex.sample_table[0]);
+	*sample_id = MLX5_GET(parse_graph_flow_match_sample, sample, flow_match_sample_field_id);
+	return 0;
+}
+
+static void flex_l4_destroy(struct mlx5_core_dev *mdev, u32 obj_id)
+{
+	u32 out[MLX5_ST_SZ_DW(general_obj_out_cmd_hdr)] = {};
+	u32 in[MLX5_ST_SZ_DW(general_obj_in_cmd_hdr)] = {};
+
+	MLX5_SET(general_obj_in_cmd_hdr, in, opcode, MLX5_CMD_OP_DESTROY_GENERAL_OBJECT);
+	MLX5_SET(general_obj_in_cmd_hdr, in, obj_type, MLX5_OBJ_TYPE_FLEX_PARSE_GRAPH);
+	MLX5_SET(general_obj_in_cmd_hdr, in, obj_id, obj_id);
+
+	mlx5_cmd_exec(mdev, in, sizeof(in), out, sizeof(out));
+}
+
+static int flex_l4_get(struct mlx5e_priv *priv, u8 proto, u32 *sample_id)
+{
+	struct mlx5e_ethtool_steering *ethtool = mlx5e_fs_get_ethtool(priv->fs);
+	struct mlx5e_ethtool_flex_l4 *flex_l4 = &ethtool->flex_l4;
+	struct mlx5_core_dev *mdev = priv->mdev;
+	int err;
+
+	if (flex_l4->refcount && flex_l4->proto != proto) {
+		netdev_err(priv->netdev, "%s: l4_4_bytes rules already match IP protocol %u\n",
+			   __func__, flex_l4->proto);
+		return -EBUSY;
+	}
+
+	if (!flex_l4->refcount) {
+		if (!(MLX5_CAP_GEN_64(mdev, general_obj_types) &
+		      MLX5_GENERAL_OBJ_TYPES_CAP_FLEX_PARSE_GRAPH))
+			return -EOPNOTSUPP;
+
+		err = flex_l4_create(mdev, proto, &flex_l4->obj_id);
+		if (err)
+			return err;
+
+		err = flex_l4_query_sample_id(mdev, flex_l4->obj_id, &flex_l4->sample_id);
+		if (err) {
+			flex_l4_destroy(mdev, flex_l4->obj_id);
+			return err;
+		}
+		flex_l4->proto = proto;
+	}
+
+	flex_l4->refcount++;
+	*sample_id = flex_l4->sample_id;
+	return 0;
+}
+
+static void flex_l4_put(struct mlx5e_flow_steering *fs)
+{
+	struct mlx5e_ethtool_flex_l4 *flex_l4 = &mlx5e_fs_get_ethtool(fs)->flex_l4;
+
+	if (--flex_l4->refcount)
+		return;
+
+	flex_l4_destroy(mlx5e_fs_get_mdev(fs), flex_l4->obj_id);
+}
+
+static int set_flex_l4(struct mlx5e_priv *priv, struct mlx5e_ethtool_rule *eth_rule,
+		       struct mlx5_flow_spec *spec, struct ethtool_rx_flow_spec *fs)
+{
+	__be32 val, mask;
+	u32 sample_id;
+	void *misc4;
+	u8 proto;
+	int err;
+
+	switch (flow_type_mask(fs->flow_type)) {
+	case IP_USER_FLOW:
+		proto = fs->h_u.usr_ip4_spec.proto;
+		val = fs->h_u.usr_ip4_spec.l4_4_bytes;
+		mask = fs->m_u.usr_ip4_spec.l4_4_bytes;
+		break;
+	default:
+		return 0;
+	}
+	if (!mask)
+		return 0;
+
+	err = flex_l4_get(priv, proto, &sample_id);
+	if (err)
+		return err;
+	eth_rule->flex_l4 = true;
+
+	/* The sample holds the four header bytes in wire order */
+	misc4 = MLX5_ADDR_OF(fte_match_param, spec->match_criteria, misc_parameters_4);
+	MLX5_SET(fte_match_set_misc4, misc4, prog_sample_field_id_0, sample_id);
+	MLX5_SET(fte_match_set_misc4, misc4, prog_sample_field_value_0, be32_to_cpu(mask));
+	misc4 = MLX5_ADDR_OF(fte_match_param, spec->match_value, misc_parameters_4);
+	MLX5_SET(fte_match_set_misc4, misc4, prog_sample_field_id_0, sample_id);
+	MLX5_SET(fte_match_set_misc4, misc4, prog_sample_field_value_0, be32_to_cpu(val & mask));
+	spec->match_criteria_enable |= MLX5_MATCH_MISC_PARAMETERS_4;
+	return 0;
+}
+
 static struct mlx5_flow_handle *
 add_ethtool_flow_rule(struct mlx5e_priv *priv,
 		      struct mlx5e_ethtool_rule *eth_rule,
@@ -473,6 +664,10 @@ add_ethtool_flow_rule(struct mlx5e_priv *priv,
 	if (err)
 		goto free;
 
+	err = set_flex_l4(priv, eth_rule, spec, fs);
+	if (err)
+		goto free;
+
 	if (fs->ring_cookie == RX_CLS_FLOW_DISC) {
 		flow_act.action = MLX5_FLOW_CONTEXT_ACTION_DROP;
 	} else {
@@ -490,7 +685,7 @@ add_ethtool_flow_rule(struct mlx5e_priv *priv,
 		flow_act.action = MLX5_FLOW_CONTEXT_ACTION_FWD_DEST;
 	}
 
-	spec->match_criteria_enable = (!outer_header_zero(spec->match_criteria));
+	spec->match_criteria_enable |= !outer_header_zero(spec->match_criteria);
 	spec->flow_context.flow_tag = MLX5_FS_DEFAULT_FLOW_TAG;
 	rule = mlx5_add_flow_rules(ft, spec, &flow_act, dst, dst ? 1 : 0);
 	if (IS_ERR(rule)) {
@@ -513,6 +708,8 @@ static void del_ethtool_rule(struct mlx5e_flow_steering *fs,
 		mlx5_del_flow_rules(eth_rule->rule);
 	if (eth_rule->rss)
 		mlx5e_rss_refcnt_dec(eth_rule->rss);
+	if (eth_rule->flex_l4)
+		flex_l4_put(fs);
 	list_del(&eth_rule->list);
 	ethtool->tot_num_rules--;
 	put_flow_table(eth_rule->eth_ft);
@@ -594,9 +791,13 @@ static int validate_ip4(struct ethtool_rx_flow_spec *fs)
 	struct ethtool_usrip4_spec *l3_mask = &fs->m_u.usr_ip4_spec;
 	int ntuples = 0;
 
-	if (l3_mask->l4_4_bytes || l3_mask->tos ||
-	    fs->h_u.usr_ip4_spec.ip_ver != ETH_RX_NFC_IP4)
+	if (l3_mask->tos || fs->h_u.usr_ip4_spec.ip_ver != ETH_RX_NFC_IP4)
 		return -EINVAL;
+	if (l3_mask->l4_4_bytes) {
+		if (!flex_l4_supported(l3_mask->proto, fs->h_u.usr_ip4_spec.proto))
+			return -EINVAL;
+		ntuples++;
+	}
 	if (l3_mask->ip4src)
 		ntuples++;
 	if (l3_mask->ip4dst)
-- 
2.34.1

